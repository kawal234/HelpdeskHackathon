{
  "name": "helpdesk-mini-project",
  "version": "1.0.0",
  "description": "A robust ticketing system with backend API and frontend interface",
  "private": true,
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "test:backend": "cd backend && npm test",
    "migrate:backend": "cd backend && npm run migrate",
    "init-production": "cd backend && npm run init-production",
    "start": "npm run start:backend",
    "dev": "npm run dev:backend",
    "test": "npm run test:backend",
    "migrate": "npm run migrate:backend",
    "deploy": "./deploy.sh"
  },
  "keywords": [
    "helpdesk",
    "ticketing",
    "api",
    "frontend",
    "backend",
    "sla",
    "rbac"
